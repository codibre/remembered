{
  "name": "remembered",
  "description": "Easy memory cache and semaphore",
  "version": "0.13.0",
  "author": {
    "name": "Thiago O Santos <tos.oliveira@gmail.com>"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "nest build",
    "test": "jest --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "lint": "pnpm run lint:format && pnpm run lint:style",
    "lint:fix": "pnpm run lint:format:fix && pnpm run lint:style:fix",
    "lint:format": "prettier --check '**/{src,test}/**/*.ts'",
    "lint:format:fix": "prettier --write '**/{src,test}/**/*.ts'",
    "lint:style": "eslint",
    "lint:style:fix": "eslint --fix",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "preset": "ts-jest",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "./src/**/*.ts"
    ],
    "testEnvironment": "node",
    "transformIgnorePatterns": [
      "node_modules",
      "dist"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codibre/remembered.git"
  },
  "bugs": {
    "url": "https://github.com/codibre/remembered/issues"
  },
  "homepage": "https://github.com/codibre/remembered#readme",
  "keywords": [
    "local",
    "cache",
    "semaphore",
    "memory"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fast-fifo": "^1.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/fast-fifo": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "release-it": "^18.1.2",
    "@release-it/conventional-changelog": "^9.0.2",
    "ts-jest": "^29.4.3",
    "typescript": "^5.9.2"
  }
}
