{
  "name": "@remembered/redis",
  "description": "A simple semaphore/cache lib using redis, extended from remembered package",
  "version": "2.0.0",
  "author": {
    "name": "Thiago O Santos <tos.oliveira@gmail.com>"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "nest build",
    "test": "TZ=UTC jest --runInBand --forceExit",
    "test:cov": "jest --runInBand --coverage --forceExit",
    "lint": "pnpm run lint:format && pnpm run lint:style",
    "lint:fix": "pnpm run lint:format:fix && pnpm run lint:style:fix",
    "lint:format": "prettier --check '**/{src,test}/**/*.ts'",
    "lint:format:fix": "prettier --write '**/{src,test}/**/*.ts'",
    "lint:style": "eslint",
    "lint:style:fix": "eslint --fix",
    "lint:staged": "lint-staged -c ../../.lintstagedrc",
    "prepare": "husky"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "preset": "ts-jest",
    "coverageDirectory": "./coverage",
    "collectCoverageFrom": [
      "./src/**/*.ts"
    ],
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./test/setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules",
      "dist"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codibre/remembered.git"
  },
  "bugs": {
    "url": "https://github.com/codibre/remembered/issues"
  },
  "homepage": "https://github.com/codibre/remembered/tree/main/libs/remembered-redis",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "ioredis": "*",
    "opossum": ">=4.2.4"
  },
  "peerDependenciesMeta": {
    "opossum": {
      "optional": true
    }
  },
  "dependencies": {
    "clone": "^2.1.2",
    "get-safe-instance": "*",
    "multi-serializer": "*",
    "redis-semaphore": "^5.5.0",
    "remembered": "workspace:^",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/clone": "^2.1.1",
    "@types/ioredis": "^4.27.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.17.0",
    "@types/opossum": "^8.1.6",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "ioredis": "*",
    "jest": "^30.1.3",
    "jest-callslike": "^0.2.1",
    "opossum": "^8.1.3",
    "prettier": "^3.6.2",
    "redis-mock": "^0.56.3",
    "release-it": "^18.1.2",
    "@release-it/conventional-changelog": "^9.0.2",
    "ts-jest": "^29.4.3",
    "typescript": "^5.9.2",
    "@types/uuid": "^8.3.1"
  }
}
